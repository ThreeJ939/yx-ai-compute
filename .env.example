SERVICE_ID=ai-compute-service
HEALTH_PORT=18100
LOG_LEVEL=INFO

# Kafka (align with yx-ai-recognition)
# Set false for local preview-only: HTTP /health /capabilities /preview, no Kafka.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=192.168.70.8:29092
KAFKA_USERNAME=admin
KAFKA_PASSWORD=yxkj@2026
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_REQUEST_TOPIC=ai.inference.request
KAFKA_RESULT_TOPIC=ai.inference.result
KAFKA_GROUP_ID=yx-ai-compute-group
# Max in-flight Kafka messages (YOLO serial; LLM stages overlap). GPU ~5 for 35 streams.
KAFKA_MAX_CONCURRENT=5

# MinIO (direct object download; ephemeral frames have no data-storage metadata)
MINIO_ENDPOINT=192.168.70.8:9000
MINIO_ACCESS_KEY=YToHD8OQYJFzUAFAPXbM
MINIO_SECRET_KEY=2KmfTLcEJfp0VNQjNhEmp2XqibWrRrkxU9k06h9H
MINIO_SECURE=false
# Optional annotated upload (leave empty to skip; imageUrl slots will be "")
ANNOTATED_BUCKET=

# cpu / cuda
DEVICE=cpu
# YOLO-World
YOLO_WORLD_WEIGHTS=weights/yolov8s-worldv2.pt
YOLO_CLIP_WEIGHTS=weights/clip/ViT-B-32.pt
# YOLO-World (world backend) detect thresholds
YOLO_CONF=0.3
YOLO_IOU=0.15
# Sliding-window (far / small objects). Set YOLO_TILED=false to force full-image only.
YOLO_TILED=true
YOLO_TILE_SIZE=640
YOLO_TILE_OVERLAP=0.15
YOLO_IMGSZ=1280
# Tiles per predict() call when YOLO_TILED=true (1=serial; raise if VRAM allows)
YOLO_TILE_BATCH=4

# Dedicated fire/smoke YOLOv8 weights (AGPL-3.0 third-party). Set true when file exists.
FIRE_SMOKE_WEIGHTS=weights/fire-smoke-yolov8n-2.pt
FIRE_SMOKE_ENABLED=true
FIRE_SMOKE_CONF=0.3
FIRE_SMOKE_IOU=0.15
# fire_smoke backend 独立滑窗/阈值（CONF/IOU 为 0 时沿用 YOLO_CONF / YOLO_IOU）
FIRE_SMOKE_TILED=false
FIRE_SMOKE_TILE_SIZE=640
FIRE_SMOKE_TILE_OVERLAP=0.2
FIRE_SMOKE_TILE_BATCH=4

# Dedicated dredge (illegal sand-mining) YOLOv8. Set true when weights file exists.
DREDGE_WEIGHTS=weights/dredge-yolov8n-640.pt
DREDGE_ENABLED=true
DREDGE_CONF=0.35
DREDGE_IOU=0.45
DREDGE_TILED=true
DREDGE_TILE_SIZE=640
DREDGE_TILE_OVERLAP=0.2
DREDGE_TILE_BATCH=4
DREDGE_IMGSZ=640

# Preview UI  — GET /preview (HTML page) + POST /preview/image (live inference)
# Set false in strict production environments if you don't need the browser UI.
PREVIEW_ENABLED=true
# Stream pacing (ms). On CPU use 800–2000; GPU can try 200–500.
PREVIEW_INTERVAL_MS=500
# Downscale frames wider than this before YOLO (0 = full size)
PREVIEW_MAX_WIDTH=0
PREVIEW_JPEG_QUALITY=80

# LLM / VLM behavior enhancer (OpenAI-compatible). Off by default → NoopBehaviorEnhancer.
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:56986/v1
LLM_API_KEY=test
LLM_MODEL=Qwen3.5-9B
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.1
# VLM confidence below this is treated as unconfirmed (no behavior label)
LLM_CONF_THRESHOLD=0.5
LLM_PROMPTS_PATH=config/llm_prompts.yaml
# Per-request crop concurrency (align with LLM backend instance count behind nginx)
LLM_CROP_CONCURRENCY=3
