# Service
SERVICE_ID=ai-compute-service
HEALTH_PORT=18100
LOG_LEVEL=INFO

# Kafka (align with yx-ai-recognition)
# Set false for local preview-only: HTTP /health /capabilities /preview, no Kafka.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=yxdev.com:29092
KAFKA_USERNAME=admin
KAFKA_PASSWORD=yxkj@2026
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_REQUEST_TOPIC=ai.inference.request
KAFKA_RESULT_TOPIC=ai.inference.result
KAFKA_GROUP_ID=yx-ai-compute-group

# MinIO (direct object download; ephemeral frames have no data-storage metadata)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

DEVICE=cuda
# YOLO-World
YOLO_WORLD_WEIGHTS=weights/yolov8s-worldv2.pt
# OpenAI CLIP ViT-B/32 for set_classes (offline). Empty = Ultralytics auto-download.
# YOLO_CLIP_WEIGHTS=weights/clip/ViT-B-32.pt
# Or reuse demo:
# YOLO_CLIP_WEIGHTS=D:/java_workspace/YongXin/yolo-world-demo/weights/clip/ViT-B-32.pt
YOLO_CLIP_WEIGHTS=weights/clip/ViT-B-32.pt
# YOLO-World (world backend) detect thresholds
YOLO_CONF=0.15
YOLO_IOU=0.45
# Sliding-window (far / small objects). Set YOLO_TILED=false to force full-image only.
YOLO_TILED=true
YOLO_TILE_SIZE=640
YOLO_TILE_OVERLAP=0.2
YOLO_IMGSZ=640

# Dedicated fire/smoke YOLOv8 weights (AGPL-3.0 third-party). Set true when file exists.
FIRE_SMOKE_WEIGHTS=weights/fire-smoke-yolov8n.pt
FIRE_SMOKE_ENABLED=false
# fire_smoke backend 独立滑窗/阈值（CONF/IOU 为 0 时沿用 YOLO_CONF / YOLO_IOU）
FIRE_SMOKE_TILED=true
FIRE_SMOKE_TILE_SIZE=640
FIRE_SMOKE_TILE_OVERLAP=0.2
FIRE_SMOKE_CONF=0
FIRE_SMOKE_IOU=0

# Optional annotated upload (leave empty to skip; imageUrl slots will be "")
ANNOTATED_BUCKET=

# Preview UI  — GET /preview + POST /preview/image + WS /preview/stream
# Set false in strict production environments if you don't need the browser UI.
PREVIEW_ENABLED=true
# Stream pacing (ms). On CPU use 800–2000; GPU can try 200–500.
PREVIEW_INTERVAL_MS=500
# Downscale frames wider than this before YOLO (0 = full size)
PREVIEW_MAX_WIDTH=1280
PREVIEW_JPEG_QUALITY=80

# LLM / VLM behavior enhancer (OpenAI-compatible). Off by default → NoopBehaviorEnhancer.
LLM_ENABLED=false
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-vl-plus
LLM_TIMEOUT_MS=8000
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.1
# VLM confidence below this is treated as unconfirmed (no behavior label)
LLM_CONF_THRESHOLD=0.5
LLM_PROMPTS_PATH=config/llm_prompts.yaml
# Request response_format=json_object (same as yx-agent-router). Set false if local VLM rejects it.
LLM_JSON_OBJECT=true
